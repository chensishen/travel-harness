# Copy to .env. Never commit .env or paste keys into tracked files.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_MODEL=workbuddy/deepseek-v4.1-flash
SILICONFLOW_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
MILVUS_URI=http://127.0.0.1:19530
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
ATTU_PORT=8001
MCP_CONFIG_PATH=~/.codex/config.toml
MCP_SEARCH_SERVER=exa
MCP_FETCH_SERVER=fetch
MCP_IMAGE_SERVER=magpie-image
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
PHOTO_SIMILARITY_MIN=0.20
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT="TravelHarness/0.1 (via Codex; https://github.com/openai/codex)"
FETCH_PROXY_FAKE_IP=false
DATA_DIR=data
PRIMARY_COLOR=#176B5B
# Bounded research parallelism; use 1 for a conservative serial comparison.
RESEARCH_CONCURRENCY=2
FETCH_CONCURRENCY=3
